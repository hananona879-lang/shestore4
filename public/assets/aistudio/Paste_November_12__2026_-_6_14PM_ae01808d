        return `
          <div class="group flex flex-col bg-white">
            <div onclick="openProductModal(${p.id})" class="relative aspect-[3/4] w-full overflow-hidden bg-neutral-100 cursor-pointer mb-2.5">
              <img id="p-img-${p.id}" src="${v.image}" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" />
              <span class="absolute top-2 right-2 bg-black text-white text-[9px] font-bold px-2 py-0.5 tracking-wider">
                ${p.badge}
              </span>
            </div>

            <!-- دوائر الألوان تحت الصورة وتغيير اسم اللون والصورة مباشرة -->
            <div class="flex items-center gap-1.5 mb-1.5 px-0.5">
              ${dots}
              <span id="p-color-name-${p.id}" class="text-[11px] text-neutral-600 mr-2 font-medium">${v.colorName}</span>
            </div>

            <div class="px-0.5 flex flex-col flex-1 justify-between">
              <div>
                <h3 onclick="openProductModal(${p.id})" class="font-bold text-xs md:text-sm leading-snug cursor-pointer hover:underline text-neutral-900">${p.name}</h3>
                <p class="text-[10px] text-neutral-400 mt-0.5 line-clamp-1">${p.desc}</p>
              </div>

              <div class="flex items-center justify-between mt-2.5 pt-2 border-t border-black/5">
                <span class="font-black text-xs md:text-sm tracking-tight text-black">${p.price} <span class="text-[10px] font-normal">ج.م</span></span>
                <button onclick="openProductModal(${p.id})" class="text-xs bg-black text-white hover:bg-neutral-800 transition-colors px-3 py-1 font-semibold">
                  طلب
                </button>
              </div>
            </div>
          </div>
        `;
      }).join("");
    }

    // تبديل اللون والصورة مباشرة
    function switchCardColor(prodId, varIdx) {
      currentSelectedVariants[prodId] = varIdx;
      const product = PRODUCTS.find(p => p.id === prodId);
      const variant = product.variants[varIdx];
      document.getElementById(`p-img-${prodId}`).src = variant.image;
      document.getElementById(`p-color-name-${prodId}`).innerText = variant.colorName;
      renderProducts();
    }

    // فتح نافذة المنتج
    function openProductModal(prodId) {
      modalProduct = PRODUCTS.find(p => p.id === prodId);
      modalVariantIndex = currentSelectedVariants[prodId];
      modalSelectedSize = modalProduct.sizes[0];
      modalQuantity = 1;
      updateModalUI();
      document.getElementById("product-modal").classList.remove("hidden");
    }

    function closeProductModal() {
      document.getElementById("product-modal").classList.add("hidden");
    }

    function updateModalUI() {
      const v = modalProduct.variants[modalVariantIndex];
      document.getElementById("modal-img").src = v.image;
      document.getElementById("modal-badge").innerText = modalProduct.badge;
      document.getElementById("modal-title").innerText = modalProduct.name;
      document.getElementById("modal-desc").innerText = modalProduct.desc;
      document.getElementById("modal-price").innerText = `${modalProduct.price} جنيه مصري (سعر المصنع)`;
      document.getElementById("modal-color-name").innerText = v.colorName;
      document.getElementById("modal-qty").innerText = modalQuantity;

      // ألوان المودال
      document.getElementById("modal-colors").innerHTML = modalProduct.variants.map((vr, i) => `
        <button onclick="selectModalVariant(${i})" style="background-color: ${vr.hex};" class="w-6 h-6 rounded-full border transition-all ${
          modalVariantIndex === i ? 'ring-2 ring-black ring-offset-2 scale-110 border-transparent' : 'border-neutral-400 opacity-60'
        }"></button>
      `).join("");

      // مقاسات المودال
      document.getElementById("modal-sizes").innerHTML = modalProduct.sizes.map(sz => `
        <button onclick="selectModalSize('${sz}')" class="px-3 h-8 text-xs font-semibold border transition-all ${
          modalSelectedSize === sz ? 'bg-black text-white border-black' : 'bg-white text-black border-neutral-300 hover:border-black'
        }">${sz}</button>
      `).join("");
    }

    function selectModalVariant(idx) {
      modalVariantIndex = idx;
      updateModalUI();
    }

    function selectModalSize(sz) {
      modalSelectedSize = sz;
      updateModalUI();
    }

    function updateQty(delta) {
      modalQuantity = Math.max(1, modalQuantity + delta);
      document.getElementById("modal-qty").innerText = modalQuantity;
    }

    // إضافة إلى الحقيبة
    function addToCartCurrent() {
      const v = modalProduct.variants[modalVariantIndex];
      const cartId = `${modalProduct.id}-${modalVariantIndex}-${modalSelectedSize}`;
      const existing = cart.find(item => item.id === cartId);

      if (existing) {
        existing.quantity += modalQuantity;
      } else {
        cart.push({
          id: cartId,
          name: modalProduct.name,
          color: v.colorName,
          size: modalSelectedSize,
          price: modalProduct.price,
          quantity: modalQuantity,
          image: v.image
        });
      }

      closeProductModal();
      updateCartUI();
      toggleCart(true);
    }

    // طلب فوري
    function instantBuy() {
      const v = modalProduct.variants[modalVariantIndex];
      directOrderItem = {
        name: modalProduct.name,
        color: v.colorName,
        size: modalSelectedSize,
        price: modalProduct.price,
        quantity: modalQuantity
      };
      closeProductModal();
      openCheckoutModal(true);
    }

    // إدارة السلة
    function toggleCart(show) {
      const drawer = document.getElementById("cart-drawer");
      if (show) drawer.classList.remove("hidden");
      else drawer.classList.add("hidden");
    }

    function updateCartUI() {
      const count = cart.reduce((s, i) => s + i.quantity, 0);
      const countEl = document.getElementById("cart-count");
      if (count > 0) {
        countEl.innerText = count;
        countEl.classList.remove("hidden");
      } else {
        countEl.classList.add("hidden");
      }

      const total = cart.reduce((s, i) => s + (i.price * i.quantity), 0);
      document.getElementById("cart-total-price").innerText = `${total} ج.م`;

      const list = document.getElementById("cart-items");
      if (cart.length === 0) {
        list.innerHTML = `<div class="text-center py-20 text-neutral-400 text-xs">حقيبة التسوق فارغة</div>`;
      } else {
        list.innerHTML = cart.map((it, idx) => `
          <div class="flex gap-3 border-b border-neutral-100 pb-3 items-center">
            <img src="${it.image}" class="w-14 h-16 object-cover border" />
            <div class="flex-1 text-xs">
              <h4 class="font-bold">${it.name}</h4>
              <p class="text-neutral-500">${it.color} | ${it.size}</p>
              <p class="text-neutral-400">الكمية: ${it.quantity}</p>
              <p class="font-extrabold mt-0.5">${it.price * it.quantity} ج.م</p>
            </div>
            <button onclick="removeFromCart(${idx})" class="text-neutral-400 hover:text-black font-bold p-1">✕</button>
          </div>
        `).join("");
      }
    }

    function removeFromCart(idx) {
      cart.splice(idx, 1);
      updateCartUI();
    }

    // الشيك أوت
    function openCheckoutModal(isDirect) {
      toggleCart(false);
      const modal = document.getElementById("checkout-modal");
      let total = 0;
      if (isDirect && directOrderItem) {
        total = directOrderItem.price * directOrderItem.quantity;
      } else {
        directOrderItem = null;
        total = cart.reduce((s, i) => s + (i.price * i.quantity), 0);
      }
      document.getElementById("checkout-amount").innerText = `${total} ج.م`;
      modal.classList.remove("hidden");
    }

    function closeCheckoutModal() {
      document.getElementById("checkout-modal").classList.add("hidden");
    }

    // إرسال وتنسيق الرسالة على واتساب (01115010812)
    function handleSendWhatsApp(e) {
      e.preventDefault();
      const name = document.getElementById("form-name").value;
      const phone = document.getElementById("form-phone").value;
      const gov = document.getElementById("form-gov").value;
      const address = document.getElementById("form-address").value;
      const notes = document.getElementById("form-notes").value;

      let items = directOrderItem ? [directOrderItem] : [...cart];
      let total = items.reduce((s, i) => s + (i.price * i.quantity), 0);

      let msg = `*طلب جديد من متجر SHE STORE EG* 🛍️✨\n`;
      msg += `(من حساب الإنستجرام: instagram.com/she.store._eg)\n`;
      msg += `────────────────────\n`;
      msg += `👤 *بيانات العميل للشحن:*\n`;
      msg += `• الاسم: ${name}\n`;
      msg += `• رقم الموبايل: ${phone}\n`;
      msg += `• المحافظة: ${gov}\n`;
      msg += `• العنوان بالتفصيل: ${address}\n`;
      if (notes) msg += `• ملاحظات المقاس/المندوب: ${notes}\n`;
      msg += `────────────────────\n`;
      msg += `👗 *القطع المطلوبة:*\n\n`;

      items.forEach((it, idx) => {
        msg += `${idx + 1}. *${it.name}*\n`;
        msg += `   - اللون المختار: ${it.color}\n`;
        msg += `   - المقاس: ${it.size}\n`;
        msg += `   - الكمية: ${it.quantity}\n`;
        msg += `   - السعر: ${it.price * it.quantity} ج.م\n\n`;
      });

      msg += `────────────────────\n`;
      msg += `💰 *إجمالي الأوردر:* ${total} ج.م\n`;
      msg += `🚚 الدفع عند الاستلام مع حق المعاينة قبل الدفع`;

      const url = `https://wa.me/${WHATSAPP_PHONE}?text=${encodeURIComponent(msg)}`;
      window.open(url, "_blank");

      closeCheckoutModal();
      if (!directOrderItem) {
        cart = [];
        updateCartUI();
      }
    }

    // تشغيل الصفحة
    renderProducts();
    updateCartUI();
  </script>
</body>
</html>